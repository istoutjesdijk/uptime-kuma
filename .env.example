# Set these in the platform's environment editor (Coolify), not in this repo.
# Nothing here is read at build time; every value is runtime-only.
#
# Never tick Coolify's "Shown once" on any of these: it is a one-way lock that
# masks the value as null in both the UI and the API, and the only write that
# unlocks it wipes the value.

# --- Database (Coolify-managed MariaDB resource, same destination network) ----
# Hostname is the uuid of the database resource, e.g. abcdefghijklmnopqrstuvwx.
MARIADB_SERVER=
MARIADB_PASSWORD=
MARIADB_PORT=3306
MARIADB_DATABASE=kuma
MARIADB_USER=kuma

# --- Authentik proxy outpost --------------------------------------------------
# Base URL of the Authentik server, and the token of the outpost from
# Authentik > Applications > Outposts.
AUTHENTIK_HOST=
AUTHENTIK_OUTPOST_TOKEN=

# --- Misc ---------------------------------------------------------------------
TZ=Etc/UTC

# --- Image pins ---------------------------------------------------------------
# Normally left alone: upstream-update.yml owns UPTIME_KUMA_TAG and
# authentik-sync.yml owns AUTHENTIK_TAG. Set one here (or in the platform's env)
# only to hold this deployment back on an older image.
# UPTIME_KUMA_TAG=2.5.4
# AUTHENTIK_TAG=2026.8.0
